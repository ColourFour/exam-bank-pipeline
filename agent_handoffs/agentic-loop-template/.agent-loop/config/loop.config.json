{
  "project_name": "exam-bank-pipeline",
  "iterations_per_governor_review": 5,
  "max_files_changed_per_iteration": 8,
  "max_new_files_per_iteration": 4,
  "allow_dependency_changes": false,
  "require_clean_git_status_before_iteration": false,
  "require_dirty_state_snapshot_before_iteration": true,
  "require_tests_fail_before_coder": false,
  "require_focused_tests_or_checks": true,
  "require_visual_evidence_for_image_work": true,
  "require_ocr_enabled_comparison_for_production_claims": true,
  "require_auditor_pass_before_next_iteration": false,
  "artifact_dir": ".agent-runs",
  "agent_prompt_dir": ".agent-loop/agents",
  "planner_policy": ".agent-loop/config/planner-purpose.md",
  "canonical_question_bank": "output/json/question_bank.json",
  "artifact_root": "output",
  "canonical_asset_folders": [
    "output/pm1",
    "output/pm3",
    "output/stats",
    "output/mechanics"
  ],
  "durable_topic_sidecar": "data/topic_routing/question_bank.topic_routing.v1.json",
  "topic_taxonomy": "exam_bank_taxonomy/caie_9709_syllabus_topics.v1.json",
  "agent_1_priority_order": [
    "clear_output_images",
    "correct_topic_content",
    "correct_question_json_data"
  ]
}
